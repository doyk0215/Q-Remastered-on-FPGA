// Q Remastered on FPGA: shared interface contract, revision 2.
// Verilog-2001. No behavioral RTL or physics tuning constants.
// Field packing is LSB-first; slice signed geometry with $signed(...).
// Pair with q_ports.vh and the spec's module-contracts.md.
`ifndef Q_CONTRACT_VH
`define Q_CONTRACT_VH

`define Q_CONTRACT_REV 16'h0002
`define Q_CORE_HZ 100000000
`define Q_PIXEL_HZ 25200000
`define Q_OLED_HZ 6250000
`define Q_PHYSICS_HZ 60
`define Q_SCREEN_W 640
`define Q_SCREEN_H 480
`define Q_MAX_STROKES 5
`define Q_MAX_POINTS 8
`define Q_MAX_OBSTACLES 8
`define Q_GEOM_W 18
`define Q_GEOM_FRAC 6
`define Q_ID_W 32
`define Q_STAGE_W 2
`define Q_BODY_ID_W 3
`define Q_POINT_COUNT_W 4
`define Q_ACCEPTED_COUNT_W 3
`define Q_OBSTACLE_COUNT_W 4
`define Q_MODE_W 2
`define Q_ACTION_W 4
`define Q_FOCUS_W 4
`define Q_CTRL_OP_W 3
`define Q_RESULT_W 2
`define Q_REASON_W 3
`define Q_FEEDBACK_W 3
`define Q_FAULT_W 8
`define Q_FRAME_DISPOSITION_W 2
`define Q_SCREEN_X_BITS 10
`define Q_SCREEN_Y_BITS 9
`define Q_BIT_W 1

`define Q_STAGE_0 2'd0
`define Q_STAGE_1 2'd1
`define Q_STAGE_2 2'd2
`define Q_STAGE_NONE 2'd3
`define Q_BODY_BALL 3'd0
`define Q_BODY_INVALID 3'd7
`define Q_ID_NONE 32'd0
`define Q_MODE_LOBBY 2'd0
`define Q_MODE_ACTIVE 2'd1
`define Q_MODE_PAUSED 2'd2
`define Q_MODE_VICTORY 2'd3
`define Q_ACTION_NONE 4'd0
`define Q_ACTION_SELECT_STAGE 4'd1
`define Q_ACTION_PAUSE 4'd2
`define Q_ACTION_RESUME 4'd3
`define Q_ACTION_RESET_STAGE 4'd4
`define Q_ACTION_BACK_TO_LOBBY 4'd5
`define Q_ACTION_NEXT_STAGE 4'd6
`define Q_ACTION_CREATE_STROKE 4'd7
`define Q_FOCUS_NONE 4'd0
`define Q_FOCUS_STAGE_0 4'd1
`define Q_FOCUS_STAGE_1 4'd2
`define Q_FOCUS_STAGE_2 4'd3
`define Q_FOCUS_PAUSE 4'd4
`define Q_FOCUS_RESUME 4'd5
`define Q_FOCUS_RESET_STAGE 4'd6
`define Q_FOCUS_BACK_TO_LOBBY 4'd7
`define Q_FOCUS_NEXT_STAGE 4'd8
`define Q_CTRL_NONE 3'd0
`define Q_CTRL_LOAD_STAGE 3'd1
`define Q_CTRL_RESET_STAGE 3'd2
`define Q_CTRL_PAUSE 3'd3
`define Q_CTRL_RESUME 3'd4
`define Q_CTRL_DISCARD 3'd5
`define Q_RESULT_OK 2'd0
`define Q_RESULT_REJECTED 2'd1
`define Q_RESULT_CANCELLED 2'd2
`define Q_RESULT_STALE 2'd3
`define Q_REASON_NONE 3'd0
`define Q_REASON_OVERLAP 3'd1
`define Q_REASON_DEGENERATE 3'd2
`define Q_REASON_FULL 3'd3
`define Q_REASON_BAD_PAYLOAD 3'd4
`define Q_REASON_WRONG_STATE 3'd5
`define Q_REASON_COUNTER_EXHAUSTED 3'd6
`define Q_FEEDBACK_NONE 3'd0
`define Q_FEEDBACK_NO_STROKES 3'd1
`define Q_FEEDBACK_OVERLAP 3'd2
`define Q_FEEDBACK_INVALID_STROKE 3'd3
`define Q_FEEDBACK_PHYSICS_FAULT 3'd4
`define Q_FEEDBACK_INPUT_FAULT 3'd5
`define Q_FRAME_PRESENTED 2'd0
`define Q_FRAME_DROPPED_STALE 2'd1
`define Q_FRAME_DROPPED_CANCELLED 2'd2
`define Q_FRAME_FAULT 2'd3
`define Q_FAULT_COUNTER_BIT 0
`define Q_FAULT_PROTOCOL_BIT 1
`define Q_FAULT_INPUT_OVERFLOW_BIT 2
`define Q_FAULT_PHYSICS_DEADLINE_BIT 3
`define Q_FAULT_CONTACT_OVERFLOW_BIT 4
`define Q_FAULT_NUMERIC_OVERFLOW_BIT 5
`define Q_FAULT_RASTER_DEADLINE_BIT 6
`define Q_LED_PAUSED_BIT 0
`define Q_LED_VICTORY_BIT 1

// Point: x and y are signed Q6 geometry fields.
`define Q_POINT_X_W `Q_GEOM_W
`define Q_POINT_X_LSB 0
`define Q_POINT_Y_W `Q_GEOM_W
`define Q_POINT_Y_LSB (`Q_POINT_X_LSB + `Q_POINT_X_W)
`define Q_POINT_W (`Q_POINT_Y_LSB + `Q_POINT_Y_W)

// Static capsule, world-space endpoints and positive Q6 radius.
`define Q_CAPSULE_A_W `Q_POINT_W
`define Q_CAPSULE_A_LSB 0
`define Q_CAPSULE_B_W `Q_POINT_W
`define Q_CAPSULE_B_LSB (`Q_CAPSULE_A_LSB + `Q_CAPSULE_A_W)
`define Q_CAPSULE_RADIUS_W `Q_GEOM_W
`define Q_CAPSULE_RADIUS_LSB (`Q_CAPSULE_B_LSB + `Q_CAPSULE_B_W)
`define Q_CAPSULE_W (`Q_CAPSULE_RADIUS_LSB + `Q_CAPSULE_RADIUS_W)

`define Q_POINTS_W (`Q_MAX_POINTS * `Q_POINT_W)

// Stroke geometry: ordered points; count zero denotes an unused snapshot slot.
`define Q_STROKE_COUNT_W `Q_POINT_COUNT_W
`define Q_STROKE_COUNT_LSB 0
`define Q_STROKE_RADIUS_W `Q_GEOM_W
`define Q_STROKE_RADIUS_LSB (`Q_STROKE_COUNT_LSB + `Q_STROKE_COUNT_W)
`define Q_STROKE_POINTS_W `Q_POINTS_W
`define Q_STROKE_POINTS_LSB (`Q_STROKE_RADIUS_LSB + `Q_STROKE_RADIUS_W)
`define Q_STROKE_W (`Q_STROKE_POINTS_LSB + `Q_STROKE_POINTS_W)
`define Q_STROKE_POINT_LSB(i) (`Q_STROKE_POINTS_LSB + ((i) * `Q_POINT_W))

// Visible ball geometry; angular/mass internals stay inside physics.
`define Q_BALL_CENTER_W `Q_POINT_W
`define Q_BALL_CENTER_LSB 0
`define Q_BALL_RADIUS_W `Q_GEOM_W
`define Q_BALL_RADIUS_LSB (`Q_BALL_CENTER_LSB + `Q_BALL_CENTER_W)
`define Q_BALL_W (`Q_BALL_RADIUS_LSB + `Q_BALL_RADIUS_W)

// Adapter sample after clamping; all button levels are active high.
`define Q_MOUSE_X_W `Q_SCREEN_X_BITS
`define Q_MOUSE_X_LSB 0
`define Q_MOUSE_Y_W `Q_SCREEN_Y_BITS
`define Q_MOUSE_Y_LSB (`Q_MOUSE_X_LSB + `Q_MOUSE_X_W)
`define Q_MOUSE_LEFT_W 1
`define Q_MOUSE_LEFT_LSB (`Q_MOUSE_Y_LSB + `Q_MOUSE_Y_W)
`define Q_MOUSE_RIGHT_W 1
`define Q_MOUSE_RIGHT_LSB (`Q_MOUSE_LEFT_LSB + `Q_MOUSE_LEFT_W)
`define Q_MOUSE_MIDDLE_W 1
`define Q_MOUSE_MIDDLE_LSB (`Q_MOUSE_RIGHT_LSB + `Q_MOUSE_RIGHT_W)
`define Q_MOUSE_W (`Q_MOUSE_MIDDLE_LSB + `Q_MOUSE_MIDDLE_W)

// Cursor presentation state; left-held also controls pause availability.
`define Q_CURSOR_X_W `Q_SCREEN_X_BITS
`define Q_CURSOR_X_LSB 0
`define Q_CURSOR_Y_W `Q_SCREEN_Y_BITS
`define Q_CURSOR_Y_LSB (`Q_CURSOR_X_LSB + `Q_SCREEN_X_BITS)
`define Q_CURSOR_VISIBLE_W 1
`define Q_CURSOR_VISIBLE_LSB (`Q_CURSOR_Y_LSB + `Q_SCREEN_Y_BITS)
`define Q_CURSOR_LEFT_HELD_W 1
`define Q_CURSOR_LEFT_HELD_LSB (`Q_CURSOR_VISIBLE_LSB + `Q_CURSOR_VISIBLE_W)
`define Q_CURSOR_W (`Q_CURSOR_LEFT_HELD_LSB + `Q_CURSOR_LEFT_HELD_W)

// Input preview: controller may retain the submitted shape while admission is pending.
`define Q_PREVIEW_CURSOR_W `Q_CURSOR_W
`define Q_PREVIEW_CURSOR_LSB 0
`define Q_PREVIEW_ACTIVE_W 1
`define Q_PREVIEW_ACTIVE_LSB (`Q_PREVIEW_CURSOR_LSB + `Q_PREVIEW_CURSOR_W)
`define Q_PREVIEW_STROKE_W `Q_STROKE_W
`define Q_PREVIEW_STROKE_LSB (`Q_PREVIEW_ACTIVE_LSB + `Q_PREVIEW_ACTIVE_W)
`define Q_PREVIEW_W (`Q_PREVIEW_STROKE_LSB + `Q_PREVIEW_STROKE_W)

// Reliable input action; stroke data is meaningful only for CREATE_STROKE.
`define Q_INPUT_ACTION_ATTEMPT_W `Q_ID_W
`define Q_INPUT_ACTION_ATTEMPT_LSB 0
`define Q_INPUT_ACTION_VIEW_W `Q_ID_W
`define Q_INPUT_ACTION_VIEW_LSB (`Q_INPUT_ACTION_ATTEMPT_LSB + `Q_INPUT_ACTION_ATTEMPT_W)
`define Q_INPUT_ACTION_ACTION_W `Q_ACTION_W
`define Q_INPUT_ACTION_ACTION_LSB (`Q_INPUT_ACTION_VIEW_LSB + `Q_INPUT_ACTION_VIEW_W)
`define Q_INPUT_ACTION_STAGE_W `Q_STAGE_W
`define Q_INPUT_ACTION_STAGE_LSB (`Q_INPUT_ACTION_ACTION_LSB + `Q_INPUT_ACTION_ACTION_W)
`define Q_INPUT_ACTION_STROKE_W `Q_STROKE_W
`define Q_INPUT_ACTION_STROKE_LSB (`Q_INPUT_ACTION_STAGE_LSB + `Q_INPUT_ACTION_STAGE_W)
`define Q_INPUT_ACTION_W (`Q_INPUT_ACTION_STROKE_LSB + `Q_INPUT_ACTION_STROKE_W)

// Controller-to-physics create channel; no pause-after-drawing flag.
`define Q_CREATE_REQ_ATTEMPT_W `Q_ID_W
`define Q_CREATE_REQ_ATTEMPT_LSB 0
`define Q_CREATE_REQ_REQUEST_W `Q_ID_W
`define Q_CREATE_REQ_REQUEST_LSB (`Q_CREATE_REQ_ATTEMPT_LSB + `Q_CREATE_REQ_ATTEMPT_W)
`define Q_CREATE_REQ_STROKE_W `Q_STROKE_W
`define Q_CREATE_REQ_STROKE_LSB (`Q_CREATE_REQ_REQUEST_LSB + `Q_CREATE_REQ_REQUEST_W)
`define Q_CREATE_REQ_W (`Q_CREATE_REQ_STROKE_LSB + `Q_CREATE_REQ_STROKE_W)

// Exactly one terminal result per received create request.
`define Q_CREATE_RSP_ATTEMPT_W `Q_ID_W
`define Q_CREATE_RSP_ATTEMPT_LSB 0
`define Q_CREATE_RSP_REQUEST_W `Q_ID_W
`define Q_CREATE_RSP_REQUEST_LSB (`Q_CREATE_RSP_ATTEMPT_LSB + `Q_CREATE_RSP_ATTEMPT_W)
`define Q_CREATE_RSP_RESULT_W `Q_RESULT_W
`define Q_CREATE_RSP_RESULT_LSB (`Q_CREATE_RSP_REQUEST_LSB + `Q_CREATE_RSP_REQUEST_W)
`define Q_CREATE_RSP_REASON_W `Q_REASON_W
`define Q_CREATE_RSP_REASON_LSB (`Q_CREATE_RSP_RESULT_LSB + `Q_CREATE_RSP_RESULT_W)
`define Q_CREATE_RSP_BODY_W `Q_BODY_ID_W
`define Q_CREATE_RSP_BODY_LSB (`Q_CREATE_RSP_REASON_LSB + `Q_CREATE_RSP_REASON_W)
`define Q_CREATE_RSP_WORLD_REV_W `Q_ID_W
`define Q_CREATE_RSP_WORLD_REV_LSB (`Q_CREATE_RSP_BODY_LSB + `Q_CREATE_RSP_BODY_W)
`define Q_CREATE_RSP_W (`Q_CREATE_RSP_WORLD_REV_LSB + `Q_CREATE_RSP_WORLD_REV_W)

// Independent control channel remains receivable during create computation.
`define Q_CTRL_REQ_ATTEMPT_W `Q_ID_W
`define Q_CTRL_REQ_ATTEMPT_LSB 0
`define Q_CTRL_REQ_REQUEST_W `Q_ID_W
`define Q_CTRL_REQ_REQUEST_LSB (`Q_CTRL_REQ_ATTEMPT_LSB + `Q_CTRL_REQ_ATTEMPT_W)
`define Q_CTRL_REQ_OP_W `Q_CTRL_OP_W
`define Q_CTRL_REQ_OP_LSB (`Q_CTRL_REQ_REQUEST_LSB + `Q_CTRL_REQ_REQUEST_W)
`define Q_CTRL_REQ_STAGE_W `Q_STAGE_W
`define Q_CTRL_REQ_STAGE_LSB (`Q_CTRL_REQ_OP_LSB + `Q_CTRL_REQ_OP_W)
`define Q_CTRL_REQ_W (`Q_CTRL_REQ_STAGE_LSB + `Q_CTRL_REQ_STAGE_W)

// Control completion; request attempt is the target generation for load/reset/discard.
`define Q_CTRL_RSP_ATTEMPT_W `Q_ID_W
`define Q_CTRL_RSP_ATTEMPT_LSB 0
`define Q_CTRL_RSP_REQUEST_W `Q_ID_W
`define Q_CTRL_RSP_REQUEST_LSB (`Q_CTRL_RSP_ATTEMPT_LSB + `Q_CTRL_RSP_ATTEMPT_W)
`define Q_CTRL_RSP_OP_W `Q_CTRL_OP_W
`define Q_CTRL_RSP_OP_LSB (`Q_CTRL_RSP_REQUEST_LSB + `Q_CTRL_RSP_REQUEST_W)
`define Q_CTRL_RSP_RESULT_W `Q_RESULT_W
`define Q_CTRL_RSP_RESULT_LSB (`Q_CTRL_RSP_OP_LSB + `Q_CTRL_RSP_OP_W)
`define Q_CTRL_RSP_REASON_W `Q_REASON_W
`define Q_CTRL_RSP_REASON_LSB (`Q_CTRL_RSP_RESULT_LSB + `Q_CTRL_RSP_RESULT_W)
`define Q_CTRL_RSP_WORLD_REV_W `Q_ID_W
`define Q_CTRL_RSP_WORLD_REV_LSB (`Q_CTRL_RSP_REASON_LSB + `Q_CTRL_RSP_REASON_W)
`define Q_CTRL_RSP_W (`Q_CTRL_RSP_WORLD_REV_LSB + `Q_CTRL_RSP_WORLD_REV_W)

// Reliable winning event; retained world revision identifies the frozen scene.
`define Q_GOAL_ATTEMPT_W `Q_ID_W
`define Q_GOAL_ATTEMPT_LSB 0
`define Q_GOAL_WORLD_REV_W `Q_ID_W
`define Q_GOAL_WORLD_REV_LSB (`Q_GOAL_ATTEMPT_LSB + `Q_GOAL_ATTEMPT_W)
`define Q_GOAL_W (`Q_GOAL_WORLD_REV_LSB + `Q_GOAL_WORLD_REV_W)

`define Q_STROKES_W (`Q_MAX_STROKES * `Q_STROKE_W)

`define Q_CAPSULES_W (`Q_MAX_OBSTACLES * `Q_CAPSULE_W)

// Immutable complete world snapshot. Stroke slot i is body i+1.
`define Q_WORLD_ATTEMPT_W `Q_ID_W
`define Q_WORLD_ATTEMPT_LSB 0
`define Q_WORLD_WORLD_REV_W `Q_ID_W
`define Q_WORLD_WORLD_REV_LSB (`Q_WORLD_ATTEMPT_LSB + `Q_WORLD_ATTEMPT_W)
`define Q_WORLD_HAS_WORLD_W 1
`define Q_WORLD_HAS_WORLD_LSB (`Q_WORLD_WORLD_REV_LSB + `Q_WORLD_WORLD_REV_W)
`define Q_WORLD_STAGE_W `Q_STAGE_W
`define Q_WORLD_STAGE_LSB (`Q_WORLD_HAS_WORLD_LSB + `Q_WORLD_HAS_WORLD_W)
`define Q_WORLD_BALL_W `Q_BALL_W
`define Q_WORLD_BALL_LSB (`Q_WORLD_STAGE_LSB + `Q_WORLD_STAGE_W)
`define Q_WORLD_STROKE_COUNT_W `Q_ACCEPTED_COUNT_W
`define Q_WORLD_STROKE_COUNT_LSB (`Q_WORLD_BALL_LSB + `Q_WORLD_BALL_W)
`define Q_WORLD_STROKES_W `Q_STROKES_W
`define Q_WORLD_STROKES_LSB (`Q_WORLD_STROKE_COUNT_LSB + `Q_WORLD_STROKE_COUNT_W)
`define Q_WORLD_OBSTACLE_COUNT_W `Q_OBSTACLE_COUNT_W
`define Q_WORLD_OBSTACLE_COUNT_LSB (`Q_WORLD_STROKES_LSB + `Q_WORLD_STROKES_W)
`define Q_WORLD_OBSTACLES_W `Q_CAPSULES_W
`define Q_WORLD_OBSTACLES_LSB (`Q_WORLD_OBSTACLE_COUNT_LSB + `Q_WORLD_OBSTACLE_COUNT_W)
`define Q_WORLD_GOAL_STOPPED_W 1
`define Q_WORLD_GOAL_STOPPED_LSB (`Q_WORLD_OBSTACLES_LSB + `Q_WORLD_OBSTACLES_W)
`define Q_WORLD_FAULTS_W `Q_FAULT_W
`define Q_WORLD_FAULTS_LSB (`Q_WORLD_GOAL_STOPPED_LSB + `Q_WORLD_GOAL_STOPPED_W)
`define Q_WORLD_W (`Q_WORLD_FAULTS_LSB + `Q_WORLD_FAULTS_W)
`define Q_WORLD_STROKE_LSB(i) (`Q_WORLD_STROKES_LSB + ((i) * `Q_STROKE_W))
`define Q_WORLD_OBSTACLE_LSB(i) (`Q_WORLD_OBSTACLES_LSB + ((i) * `Q_CAPSULE_W))

// Complete UI record; stage/objective/menu text is selected from IDs, not string pointers.
`define Q_UI_ATTEMPT_W `Q_ID_W
`define Q_UI_ATTEMPT_LSB 0
`define Q_UI_REQUIRED_WORLD_REV_W `Q_ID_W
`define Q_UI_REQUIRED_WORLD_REV_LSB (`Q_UI_ATTEMPT_LSB + `Q_UI_ATTEMPT_W)
`define Q_UI_UI_REV_W `Q_ID_W
`define Q_UI_UI_REV_LSB (`Q_UI_REQUIRED_WORLD_REV_LSB + `Q_UI_REQUIRED_WORLD_REV_W)
`define Q_UI_VIEW_W `Q_ID_W
`define Q_UI_VIEW_LSB (`Q_UI_UI_REV_LSB + `Q_UI_UI_REV_W)
`define Q_UI_FEEDBACK_ID_W `Q_ID_W
`define Q_UI_FEEDBACK_ID_LSB (`Q_UI_VIEW_LSB + `Q_UI_VIEW_W)
`define Q_UI_MODE_W `Q_MODE_W
`define Q_UI_MODE_LSB (`Q_UI_FEEDBACK_ID_LSB + `Q_UI_FEEDBACK_ID_W)
`define Q_UI_STAGE_W `Q_STAGE_W
`define Q_UI_STAGE_LSB (`Q_UI_MODE_LSB + `Q_UI_MODE_W)
`define Q_UI_STROKES_LEFT_W `Q_ACCEPTED_COUNT_W
`define Q_UI_STROKES_LEFT_LSB (`Q_UI_STAGE_LSB + `Q_UI_STAGE_W)
`define Q_UI_FOCUS_W `Q_FOCUS_W
`define Q_UI_FOCUS_LSB (`Q_UI_STROKES_LEFT_LSB + `Q_UI_STROKES_LEFT_W)
`define Q_UI_FEEDBACK_W `Q_FEEDBACK_W
`define Q_UI_FEEDBACK_LSB (`Q_UI_FOCUS_LSB + `Q_UI_FOCUS_W)
`define Q_UI_CURSOR_W `Q_CURSOR_W
`define Q_UI_CURSOR_LSB (`Q_UI_FEEDBACK_LSB + `Q_UI_FEEDBACK_W)
`define Q_UI_PREVIEW_ACTIVE_W 1
`define Q_UI_PREVIEW_ACTIVE_LSB (`Q_UI_CURSOR_LSB + `Q_UI_CURSOR_W)
`define Q_UI_PREVIEW_W `Q_STROKE_W
`define Q_UI_PREVIEW_LSB (`Q_UI_PREVIEW_ACTIVE_LSB + `Q_UI_PREVIEW_ACTIVE_W)
`define Q_UI_W (`Q_UI_PREVIEW_LSB + `Q_UI_PREVIEW_W)

// Coherent OLED/LED status. Q_STAGE_NONE means no current stage.
`define Q_STATUS_ATTEMPT_W `Q_ID_W
`define Q_STATUS_ATTEMPT_LSB 0
`define Q_STATUS_UI_REV_W `Q_ID_W
`define Q_STATUS_UI_REV_LSB (`Q_STATUS_ATTEMPT_LSB + `Q_STATUS_ATTEMPT_W)
`define Q_STATUS_MODE_W `Q_MODE_W
`define Q_STATUS_MODE_LSB (`Q_STATUS_UI_REV_LSB + `Q_STATUS_UI_REV_W)
`define Q_STATUS_STAGE_W `Q_STAGE_W
`define Q_STATUS_STAGE_LSB (`Q_STATUS_MODE_LSB + `Q_STATUS_MODE_W)
`define Q_STATUS_STROKES_LEFT_W `Q_ACCEPTED_COUNT_W
`define Q_STATUS_STROKES_LEFT_LSB (`Q_STATUS_STAGE_LSB + `Q_STATUS_STAGE_W)
`define Q_STATUS_FEEDBACK_W `Q_FEEDBACK_W
`define Q_STATUS_FEEDBACK_LSB (`Q_STATUS_STROKES_LEFT_LSB + `Q_STATUS_STROKES_LEFT_W)
`define Q_STATUS_FAULTS_W `Q_FAULT_W
`define Q_STATUS_FAULTS_LSB (`Q_STATUS_FEEDBACK_LSB + `Q_STATUS_FEEDBACK_W)
`define Q_STATUS_W (`Q_STATUS_FAULTS_LSB + `Q_STATUS_FAULTS_W)

// Immutable level response; velocity is signed Q6 pixels per outer physics step.
`define Q_LEVEL_STAGE_W `Q_STAGE_W
`define Q_LEVEL_STAGE_LSB 0
`define Q_LEVEL_STAGE_VALID_W 1
`define Q_LEVEL_STAGE_VALID_LSB (`Q_LEVEL_STAGE_LSB + `Q_LEVEL_STAGE_W)
`define Q_LEVEL_BALL_W `Q_BALL_W
`define Q_LEVEL_BALL_LSB (`Q_LEVEL_STAGE_VALID_LSB + `Q_LEVEL_STAGE_VALID_W)
`define Q_LEVEL_BALL_VX_W `Q_GEOM_W
`define Q_LEVEL_BALL_VX_LSB (`Q_LEVEL_BALL_LSB + `Q_LEVEL_BALL_W)
`define Q_LEVEL_BALL_VY_W `Q_GEOM_W
`define Q_LEVEL_BALL_VY_LSB (`Q_LEVEL_BALL_VX_LSB + `Q_LEVEL_BALL_VX_W)
`define Q_LEVEL_OBSTACLE_COUNT_W `Q_OBSTACLE_COUNT_W
`define Q_LEVEL_OBSTACLE_COUNT_LSB (`Q_LEVEL_BALL_VY_LSB + `Q_LEVEL_BALL_VY_W)
`define Q_LEVEL_OBSTACLES_W `Q_CAPSULES_W
`define Q_LEVEL_OBSTACLES_LSB (`Q_LEVEL_OBSTACLE_COUNT_LSB + `Q_LEVEL_OBSTACLE_COUNT_W)
`define Q_LEVEL_W (`Q_LEVEL_OBSTACLES_LSB + `Q_LEVEL_OBSTACLES_W)
`define Q_LEVEL_REQ_W `Q_STAGE_W
`define Q_LEVEL_OBSTACLE_LSB(i) (`Q_LEVEL_OBSTACLES_LSB + ((i) * `Q_CAPSULE_W))

// Frame mailbox payload: completed bank plus matching full overlay metadata.
`define Q_FRAME_FRAME_ID_W `Q_ID_W
`define Q_FRAME_FRAME_ID_LSB 0
`define Q_FRAME_BANK_W 1
`define Q_FRAME_BANK_LSB (`Q_FRAME_FRAME_ID_LSB + `Q_FRAME_FRAME_ID_W)
`define Q_FRAME_WORLD_REV_W `Q_ID_W
`define Q_FRAME_WORLD_REV_LSB (`Q_FRAME_BANK_LSB + `Q_FRAME_BANK_W)
`define Q_FRAME_UI_W `Q_UI_W
`define Q_FRAME_UI_LSB (`Q_FRAME_WORLD_REV_LSB + `Q_FRAME_WORLD_REV_W)
`define Q_FRAME_BALL_W `Q_BALL_W
`define Q_FRAME_BALL_LSB (`Q_FRAME_UI_LSB + `Q_FRAME_UI_W)
`define Q_FRAME_HAS_BALL_W 1
`define Q_FRAME_HAS_BALL_LSB (`Q_FRAME_BALL_LSB + `Q_FRAME_BALL_W)
`define Q_FRAME_W (`Q_FRAME_HAS_BALL_LSB + `Q_FRAME_HAS_BALL_W)

// Frame mailbox acknowledgement; bank release is separate from presentation disposition.
`define Q_FRAME_ACK_ATTEMPT_W `Q_ID_W
`define Q_FRAME_ACK_ATTEMPT_LSB 0
`define Q_FRAME_ACK_FRAME_ID_W `Q_ID_W
`define Q_FRAME_ACK_FRAME_ID_LSB (`Q_FRAME_ACK_ATTEMPT_LSB + `Q_FRAME_ACK_ATTEMPT_W)
`define Q_FRAME_ACK_WORLD_REV_W `Q_ID_W
`define Q_FRAME_ACK_WORLD_REV_LSB (`Q_FRAME_ACK_FRAME_ID_LSB + `Q_FRAME_ACK_FRAME_ID_W)
`define Q_FRAME_ACK_UI_REV_W `Q_ID_W
`define Q_FRAME_ACK_UI_REV_LSB (`Q_FRAME_ACK_WORLD_REV_LSB + `Q_FRAME_ACK_WORLD_REV_W)
`define Q_FRAME_ACK_VIEW_W `Q_ID_W
`define Q_FRAME_ACK_VIEW_LSB (`Q_FRAME_ACK_UI_REV_LSB + `Q_FRAME_ACK_UI_REV_W)
`define Q_FRAME_ACK_FEEDBACK_ID_W `Q_ID_W
`define Q_FRAME_ACK_FEEDBACK_ID_LSB (`Q_FRAME_ACK_VIEW_LSB + `Q_FRAME_ACK_VIEW_W)
`define Q_FRAME_ACK_DISPOSITION_W `Q_FRAME_DISPOSITION_W
`define Q_FRAME_ACK_DISPOSITION_LSB (`Q_FRAME_ACK_FEEDBACK_ID_LSB + `Q_FRAME_ACK_FEEDBACK_ID_W)
`define Q_FRAME_ACK_RELEASED_VALID_W 1
`define Q_FRAME_ACK_RELEASED_VALID_LSB (`Q_FRAME_ACK_DISPOSITION_LSB + `Q_FRAME_ACK_DISPOSITION_W)
`define Q_FRAME_ACK_RELEASED_BANK_W 1
`define Q_FRAME_ACK_RELEASED_BANK_LSB (`Q_FRAME_ACK_RELEASED_VALID_LSB + `Q_FRAME_ACK_RELEASED_VALID_W)
`define Q_FRAME_ACK_W (`Q_FRAME_ACK_RELEASED_BANK_LSB + `Q_FRAME_ACK_RELEASED_BANK_W)

// Separate pixel-domain attempt invalidation barrier; same layout is echoed on ack.
`define Q_EPOCH_ATTEMPT_W `Q_ID_W
`define Q_EPOCH_ATTEMPT_LSB 0
`define Q_EPOCH_W (`Q_EPOCH_ATTEMPT_LSB + `Q_EPOCH_ATTEMPT_W)

`endif // Q_CONTRACT_VH

